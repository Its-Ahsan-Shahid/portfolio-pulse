# Portfolio Pulse — lean Docker image for Render free tier.
# Uses requirements-render.txt (no torch/chromadb/spacy): the app falls back
# to TF-IDF retrieval + regex entity matching, keeping RAM under 512MB.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATA_DIR=/tmp/portfolio-pulse-data \
    PIP_NO_CACHE_DIR=1

WORKDIR /code

COPY backend/requirements-render.txt .
RUN pip install -r requirements-render.txt

COPY backend/ ./backend/

# Render injects $PORT; shell form is required for env expansion.
CMD uvicorn backend.app.main:app --host 0.0.0.0 --port $PORT --workers 1
